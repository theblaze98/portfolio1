---
import { getCollection, render } from 'astro:content'
import { Picture } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import LeftArrow from '../../components/icons/LeftArrow.astro'
import Github from '../../components/icons/Github.astro'
import ExternalLink from '../../components/icons/ExternalLink.astro'
import CheckCircle from '../../components/icons/CheckCircle.astro'
import User from '../../components/icons/User.astro'
import Star from '../../components/icons/Star.astro'

export async function getStaticPaths() {
	const projects = await getCollection('projects')

	return projects.map(project => ({
		params: { id: project.slug },
		props: { project },
	}))
}

export const prerender = true

const { project } = Astro.props

const { data, slug } = project
const {
	name,
	image,
	github_url,
	demo_url,
	status,
	technologies,
	roles,
	featured,
	description,
} = data

const { Content } = await render(project)
---

<Layout title={`Proyecto: ${name}`}>
	<main class='mx-auto px-4 py-8 max-w-4xl w-11/12'>
		<a
			href='/projects'
			class='inline-flex items-center text-blue-400 hover:text-blue-300 mb-6'>
			<div class='text-xl mr-2 text-blue-400 no-underline'>
				<LeftArrow class='w-4 h-4 mr-2' />
			</div>
			<span>Volver</span>
		</a>

		<article
			class='bg-gray-800 border border-gray-700 rounded-lg overflow-hidden shadow-xl'>
			<header
				class='p-6 border-b border-gray-700 prose prose-invert md:prose-lg'>
				<h1 class='text-3xl font-bold text-white mb-2'>{name}</h1>
				<p class='text-gray-300'>{description}</p>
			</header>
			<div class='p-6'>
				<section class='mb-6 prose prose-invert md:prose-lg'>
					<h2 class='text-xl font-semibold mb-2 text-white'>
						Tecnologías utilizadas:
					</h2>
					<div class='flex flex-wrap gap-2'>
						{
							technologies.map(tech => (
								<span class='px-3 py-1 bg-blue-600 text-white text-sm font-medium rounded-full'>
									{tech}
								</span>
							))
						}
					</div>
				</section>

				<section class='mb-6 prose prose-invert md:prose-lg'>
					<h2 class='text-xl font-semibold mb-2 text-white'>
						Detalles del proyecto:
					</h2>
					<div class='grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-300'>
						<div class='flex items-center'>
							<span>Estado: {status}</span>
						</div>
						<div class='flex items-center'>
							<span>Roles: {roles.join(', ')}</span>
						</div>
					</div>
				</section>

				{
					image && (
						<section class='mt-8'>
							<div
								transition:name={`image-${slug}`}
								class='relative h-64 md:h-96 rounded-lg overflow-hidden'>
								<Picture
									src={`/images/${image}`}
									alt={`Vista previa de ${name}`}
									width={1200}
									height={675}
									class='aspect-video'
									formats={['avif', 'webp']}
								/>
							</div>
						</section>
					)
				}

				<section class='mt-8 prose prose-invert md:prose-lg'>
					<Content />
				</section>
			</div>
			<footer
				class='px-6 py-4 bg-gray-700 flex flex-col sm:flex-row justify-end items-center gap-4'>
				<a
					href={github_url}
					target='_blank'
					rel='noopener noreferrer'
					class='inline-flex items-center bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded transition-colors duration-300'>
					<div class='mr-2'>
						<Github />
					</div>
					<span>Ver en GitHub</span>
				</a>
				{
					demo_url && (
						<a
							href={demo_url}
							target='_blank'
							rel='noopener noreferrer'
							class='inline-flex items-center bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition-colors duration-300'>
							<div class='mr-2'>
								<ExternalLink />
							</div>
							<span>Ver Demo</span>
						</a>
					)
				}
			</footer>
		</article>
	</main>
</Layout>
